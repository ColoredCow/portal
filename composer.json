{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "repositories": [
    {
      "url": "https://github.com/logicforte/consoletvs-charts.git",
      "type": "git"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-gd": "*",
    "aws/aws-sdk-php": "^3.121",
    "barryvdh/laravel-snappy": "^1.0",
    "bordoni/phpass": "dev-main",
    "codegreencreative/laravel-samlidp": "^5.0",
    "doctrine/dbal": "^3.0",
    "google/apiclient": "^2.10",
    "h4cc/wkhtmltopdf-amd64": "0.12.x",
    "laravel-notification-channels/google-chat": "^3.0",
    "laravel/framework": "^10.0",
    "laravel/helpers": "^1.1",
    "laravel/legacy-factories": "^1.1",
    "laravel/socialite": "^5.0.1",
    "laravel/tinker": "^2.0",
    "laravel/ui": "^4.0",
    "laravelcollective/html": "^6.2",
    "maatwebsite/excel": "^3.1",
    "nesbot/carbon": "^2.61",
    "niklasravnsborg/laravel-pdf": "^4.1",
    "nwidart/laravel-modules": "^10.0",
    "owen-it/laravel-auditing": "^13.0",
    "revolution/laravel-google-sheets": "^6.0",
    "sentry/sentry-laravel": "^4.13",
    "spatie/laravel-permission": "^5.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "fakerphp/faker": "^1.9",
    "filp/whoops": "^2.5",
    "friendsofphp/php-cs-fixer": "^3.13",
    "larastan/larastan": "^2.0",
    "mockery/mockery": "^1.0",
    "nunomaduro/collision": "^7.0",
    "nunomaduro/phpinsights": "^2.8",
    "phpunit/phpunit": "^10.1",
    "spatie/laravel-ignition": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Modules\\": "Modules/",
      "OfficeSuite\\": "OfficeSuite/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/Seeders/"
    },
    "files": [
      "tests/utilities/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  }
}
